// Cloudflare Workers config for the OpenNext adapter (hosting spike, ADR-003).
// No account IDs or secrets here: `wrangler login` + `wrangler deploy` resolve the account at deploy time.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flightdeck-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "flightdeck-web"
    },
    {
      // Sim Bay (spreadsheet simulator), served to the browser at /simbay through the proxy in server/simbay-proxy.ts.
      "binding": "SIMBAY",
      "service": "excel-sim"
    }
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  // Production address (stegmon.com, registered 26 Nov 2026 on the same Cloudflare account). workers_dev stays on as a fallback.
  "routes": [{ "pattern": "flightdeck.stegmon.com", "custom_domain": true }]
}
