    "seed:check": "node scripts/generate-seed.ts --check"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
