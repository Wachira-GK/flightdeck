{
  "schemaVersion": 1,
  "exerciseId": "xlookup-price-list",
  "exerciseVersion": 1,
  "expected": [
    { "id": "line-1", "cell": "C2", "value": 2499, "label": "Line 1 unit price" },
    { "id": "line-2", "cell": "C3", "value": 1999, "label": "Line 2 unit price" },
    { "id": "line-3", "cell": "C4", "value": 899, "label": "Line 3 unit price (code typed in lower case)" },
    { "id": "line-4", "cell": "C5", "value": "Not listed", "label": "Line 4 (code missing from the price list)" }
  ],
  "requireFormula": ["C2", "C3", "C4", "C5"],
  "requireFunctions": { "C2": ["XLOOKUP"], "C3": ["XLOOKUP"], "C4": ["XLOOKUP"], "C5": ["XLOOKUP"] },
  "hiddenTests": [
    {
      "id": "xlp-price-review",
      "label": "prices come from the price list after a price review",
      "overrides": { "G2": "2699", "G3": "2149", "G4": "949" },
      "expect": { "C2": 2699, "C3": 2149, "C4": 949, "C5": "Not listed" }
    },
    {
      "id": "xlp-list-reordered",
      "label": "prices are found by code, not by row position",
      "overrides": {
        "E2": "SD-120", "F2": "Ladies sandal", "G2": "899",
        "E3": "SL-075", "F3": "Slipper", "G3": "499",
        "E4": "SS-210", "F4": "School shoe", "G4": "2499",
        "E5": "SN-450", "F5": "Canvas sneaker", "G5": "1999",
        "E6": "BT-330", "F6": "Ankle boot", "G6": "4599"
      },
      "expect": { "C2": 2499, "C3": 1999, "C4": 899, "C5": "Not listed" }
    },
    {
      "id": "xlp-new-listing",
      "label": "a newly listed product in the last row is found",
      "overrides": { "E6": "GB-610", "F6": "Gumboot", "G6": "1299" },
      "expect": { "C2": 2499, "C3": 1999, "C4": 899, "C5": 1299 }
    },
    {
      "id": "xlp-order-codes-change",
      "label": "prices update when the order codes change",
      "overrides": { "B2": "BT-330", "B3": "XX-000", "B4": "SL-075", "B5": "sn-450" },
      "expect": { "C2": 4599, "C3": "Not listed", "C4": 499, "C5": 1999 }
    }
  ],
  "passThreshold": 100
}
